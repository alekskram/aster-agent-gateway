[Unit]
Description=Aster Agent Gateway - fixture recorder schedule (6h)
Documentation=https://github.com/alekskram/aster-agent-gateway

[Timer]
# Every 6 hours; keeps tests/fixtures/ schema-realistic without
# approaching any rate budget (a pass costs ~40 fapi weight, ~4 sapi
# weight and 1 solana request).
# OPT-IN ONLY: this unit ships DISABLED. Enable explicitly with
#   systemctl enable --now aster-recorder.timer
OnCalendar=*-*-* 00/6:00:00
Persistent=true

[Install]
WantedBy=timers.target
